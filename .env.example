# Environment Variables for Netlify

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Claude settings
CLAUDE_MODEL=claude-sonnet-4-6

# Optional caps / safety
AI_ENABLED=true
AI_MAX_PROMPT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=500
AI_RATE_WINDOW_MS=60000
AI_RATE_MAX_REQUESTS=20

# Admin dashboard access (comma-separated list)
# Example: ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=admin@example.com

# Optional price used for revenue estimate
CV_PRICE_ZMW=50
